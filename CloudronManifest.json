{
  "id": "dev.tripod0429.peergos-app",
  "title": "Peergos",
  "author": "Peergos Developers",
  "tagline": "Private, end-to-end encrypted storage, sharing and social",
  "description": "file://DESCRIPTION.md",
  "postInstallMessage": "file://POSTINSTALL.md",
  "changelog": "file://CHANGELOG",
  "version": "1.2.0",
  "upstreamVersion": "1.40.0",
  "website": "https://peergos.org",
  "upstreamLicense": {
    "name": "AGPL-3.0",
    "url": "https://github.com/Peergos/Peergos/blob/master/Licence.txt"
  },
  "contactEmail": "peergos-cloudron.1m67w@8shield.net",
  "packagerName": "tripod0429",
  "packagerUrl": "https://github.com/tripod0429",
  "packageUrl": "https://github.com/tripod0429/peergos-app",
  "documentationUrl": "https://github.com/tripod0429/peergos-app#readme",
  "icon": "file://logo.png",
  "iconUrl": "https://raw.githubusercontent.com/tripod0429/peergos-app/main/logo.png",
  "mediaLinks": [
    "https://raw.githubusercontent.com/tripod0429/peergos-app/main/screenshots/drive.png",
    "https://raw.githubusercontent.com/tripod0429/peergos-app/main/screenshots/share.jpg",
    "https://raw.githubusercontent.com/tripod0429/peergos-app/main/screenshots/calendar.png"
  ],
  "tags": [
    "storage",
    "sync",
    "sharing",
    "social"
  ],
  "minBoxVersion": "10.0.0",
  "manifestVersion": 2,
  "httpPort": 8000,
  "healthCheckPath": "/",
  "memoryLimit": 2147483648,
  "multiDomain": true,
  "addons": {
    "localstorage": {
      "sqlite": {
        "paths": [
          "/app/data/peergos/login.sql",
          "/app/data/peergos/mutable.sql",
          "/app/data/peergos/social.sql",
          "/app/data/peergos/quotas.sql",
          "/app/data/peergos/space-usage.sql",
          "/app/data/peergos/space-requests.sql",
          "/app/data/peergos/link-counts.sql",
          "/app/data/peergos/server-messages.sql",
          "/app/data/peergos/serverids.sql",
          "/app/data/peergos/bats.sql",
          "/app/data/peergos/blockmetadata-v3.sql",
          "/app/data/peergos/partition-status.sql",
          "/app/data/peergos/transactions.sql",
          "/app/data/peergos/address-book.sqlite",
          "/app/data/peergos/.ipfs/datastore/records.sqlite"
        ]
      }
    }
  },
  "tcpPorts": {
    "IPFS_TCP_PORT": {
      "title": "P2P port (TCP)",
      "description": "Peer-to-peer connections from other Peergos servers and clients",
      "defaultValue": 4001,
      "containerPort": 4001
    }
  },
  "udpPorts": {
    "IPFS_UDP_PORT": {
      "title": "P2P port (QUIC/UDP)",
      "description": "Peer-to-peer QUIC connections from other Peergos servers and clients",
      "defaultValue": 4001,
      "containerPort": 4001
    }
  },
  "checklist": {
    "create-first-account": {
      "message": "Create the first account with the signup link from the app logs (search for `signup=true` and remove the `:8000` from the link)"
    },
    "add-wildcard-alias": {
      "message": "Add a wildcard alias for this app's own hostname, e.g. `*.peergos.example.com` for an app at peergos.example.com (not `*.example.com`). The built-in apps (PDF viewer, calendar, editor, ...) and third-party apps load from its subdomains, and Cloudron doesn't add the alias by itself"
    }
  }
}
