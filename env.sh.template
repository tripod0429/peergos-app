# Peergos settings
#
# Edit this file with the File Manager in the Cloudron dashboard, then restart
# the app. Remove the "#" in front of a line to use it. Lines are bash, so
# quote values that contain spaces.
#
# The domain, web port, P2P listeners and native libraries are managed by the
# package and can't be changed here.

# Usernames (comma-separated) that can manage signup tokens and approve space
# requests in the web UI.
# export PEERGOS_ADMIN_USERNAMES=alice

# Storage for each NEW user, in bytes. Peergos' default is 1 GiB (1073741824).
# Existing users keep the quota they signed up with; change theirs from the Web
# Terminal with (run it as cloudron, or the app can't write the database after)
#   gosu cloudron:cloudron java -jar /app/code/Peergos.jar quota set -username <name> -quota 100g
# export PEERGOS_DEFAULT_QUOTA=10737418240

# Print one more single-use signup link to the logs on the next start.
# Set it back to false afterwards, or every restart creates another token.
# export PEERGOS_GENERATE_TOKEN=false

# Public IP to announce to other Peergos nodes. Defaults to this app's DNS
# A record, which is wrong behind Cloudflare's proxy or NAT. "none" disables it.
# export PEERGOS_PUBLIC_IP=203.0.113.10

# Minimum time in seconds a user must take to upload their whole quota.
# export PEERGOS_QUOTA_UPLOAD_LIMIT_SECONDS=600

# Log level: SEVERE, WARNING (default) or INFO. INFO adds two lines for every
# request relayed to another Peergos node, thousands on the first start.
# export PEERGOS_LOG_LEVEL=INFO

# JVM heap as a percentage of the app's memory limit (set under Resources).
# export PEERGOS_MAX_RAM_PERCENTAGE=60

# Any other Peergos flags, split on spaces. Examples:
#   open signup for up to 5 users:  -max-users 5
#   S3 storage:                     -use-s3 true -s3.bucket mybucket ...
# export PEERGOS_EXTRA_ARGS=""
